    .cubes-loader-container {
      transform: scale(0.5); /* Overall scale adjustment */
    }
    .cubes-loader {
      position: absolute;
      top: 50%;
      left: 50%;
      transform-style: preserve-3d;
    }

    .cubes-loop {
      transform: rotateX(-35deg) rotateY(-45deg) translateZ(0.78125em); /* Adjusted */
    }

    @keyframes cubes-s-animation {
      to {
        transform: scale3d(0.2, 0.2, 0.2);
      }
    }

    .cubes-item {
      margin: -0.78125em; /* Adjusted */
      width: 1.5625em; /* Adjusted */
      height: 1.5625em; /* Adjusted */
      transform-origin: 50% 50% -0.78125em; /* Adjusted */
      box-shadow: 0 0 0.0625em currentColor; /* Adjusted */
      background: currentColor;
      animation: cubes-s-animation 0.6s cubic-bezier(0.45, 0.03, 0.51, 0.95) infinite alternate;
    }

    .cubes-item:before,
    .cubes-item:after {
      position: absolute;
      width: inherit;
      height: inherit;
      transform-origin: 0 100%;
      box-shadow: inherit;
      background: currentColor;
      content: "";
    }

    .cubes-item:before {
      bottom: 100%;
      transform: rotateX(90deg);
    }

    .cubes-item:after {
      left: 100%;
      transform: rotateY(90deg);
    }

    /* Shades of Gray */
    .cubes-item:nth-child(1) {
      margin-top: 3.125em;
      color: #686868; /* Darker Gray */
      animation-delay: -1.2s;
    }
    .cubes-item:nth-child(1):before { color: #A0A0A0; } /* Medium Gray */
    .cubes-item:nth-child(1):after { color: #404040; } /* Darkest Gray */

    .cubes-item:nth-child(2) {
      margin-top: 1.5625em;
      color: #707070; 
      animation-delay: -1s;
    }
    .cubes-item:nth-child(2):before { color: #A8A8A8; }
    .cubes-item:nth-child(2):after { color: #484848; }

    .cubes-item:nth-child(3) {
      margin-top: 0em;
      color: #787878;
      animation-delay: -0.8s;
    }
    .cubes-item:nth-child(3):before { color: #B0B0B0; }
    .cubes-item:nth-child(3):after { color: #505050; }

    .cubes-item:nth-child(4) {
      margin-top: -1.5625em;
      color: #808080; /* Standard Gray */
      animation-delay: -0.6s;
    }
    .cubes-item:nth-child(4):before { color: #B8B8B8; }
    .cubes-item:nth-child(4):after { color: #585858; }

    .cubes-item:nth-child(5) {
      margin-top: -3.125em;
      color: #888888;
      animation-delay: -0.4s;
    }
    .cubes-item:nth-child(5):before { color: #C0C0C0; } /* Silver/LightGray */
    .cubes-item:nth-child(5):after { color: #606060; }

    .cubes-item:nth-child(6) {
      margin-top: -4.6875em;
      color: #909090; /* Lighter Gray */
      animation-delay: -0.2s;
    }
    .cubes-item:nth-child(6):before { color: #C8C8C8; }
    .cubes-item:nth-child(6):after { color: #686868; } /* Darker Gray (same as child 1 main) */

    /* Text Gradient Animation */
    .animated-gradient-text {
      background-image: linear-gradient(
        to right,
        #8A2BE2, /* BlueViolet */
        #4169E1, /* RoyalBlue */
        #DB7093, /* PaleVioletRed */
        #6A5ACD, /* SlateBlue */
        #00BFFF, /* DeepSkyBlue */
        #FF69B4, /* HotPink */
        #8A2BE2 /* Loop back to start color */
      );
      background-size: 300% auto; /* Increased size for smoother/slower animation if desired */
      color: transparent;
      -webkit-background-clip: text;
      background-clip: text;
      animation: text-gradient-animation 4s linear infinite;
    }

    @keyframes text-gradient-animation {
      0% { background-position: 0% center; }
      50% { background-position: 100% center; }
      100% { background-position: 0% center; }
    }

    @keyframes progress-shine {
      0% { opacity: 0; }
      50% { opacity: 1; }
      100% { opacity: 0; }
    }

    .progress-glow {
      animation: progress-shine 2s ease-in-out infinite;
    }
  `}),h.jsx("div",{className:"fixed inset-0 bg-black bg-opacity-50 dark:bg-opacity-50 backdrop-blur-lg flex flex-col items-center justify-center z-[100]",children:h.jsxs("div",{className:"bg-neutral-100 dark:bg-neutral-900 border border-white dark:border-neutral-800 rounded-3xl w-60 p-6 flex flex-col items-center animate-in slide-in-from-top-2 duration-200 shadow-beautiful-lg",children:[h.jsxs("div",{className:"cubes-loader-container h-[70px] w-[70px] relative mb-3",children:[" ",h.jsxs("div",{className:"cubes-loop cubes-loader",children:[h.jsx("div",{className:"cubes-item cubes-loader"}),h.jsx("div",{className:"cubes-item cubes-loader"}),h.jsx("div",{className:"cubes-item cubes-loader"}),h.jsx("div",{className:"cubes-item cubes-loader"}),h.jsx("div",{className:"cubes-item cubes-loader"}),h.jsx("div",{className:"cubes-item cubes-loader"})]})]}),h.jsxs("div",{className:"w-full mb-4 bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 rounded-lg p-3 overflow-hidden relative",children:[h.jsx("div",{className:"w-full h-1.5 bg-black/5 dark:bg-white/10 rounded-full overflow-hidden relative",children:h.jsx("div",{className:"h-full rounded-full transition-all duration-75 ease-out shadow-lg shadow-white/30 relative bg-gradient-to-r from-black/20 to-black/30 dark:from-white/10 dark:to-white/20",style:{width:`${r}%`},children:h.jsx("div",{className:"progress-glow absolute top-0 right-0 w-5 h-full bg-gradient-to-r from-transparent to-white/60 rounded-full"})})}),h.jsxs("div",{className:"flex justify-between text-[10px] text-neutral-500 dark:text-neutral-400 mt-1",children:[h.jsxs("span",{children:[Math.round(r),"%"]}),h.jsxs("span",{children:[Math.round(60*(100-r)/100),"s remaining"]})]})]}),h.jsx("p",{className:"text-xs uppercase text-center font-medium animated-gradient-text",children:t}),h.jsx("p",{className:"text-neutral-400 dark:text-neutral-600 text-[11px] text-center mt-1",children:s?"This image is very detailed...":"This may take a few mins."})]})})]}):n